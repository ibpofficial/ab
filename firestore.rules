rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Tracks (Read-only for public, admin/seed script write only)
    match /tracks/{trackId} {
      allow read: if true;
      allow write: if false;
    }

    // 2. Challenge Days (Read-only for public curriculum)
    match /challengeDays/{dayNumber} {
      allow read: if true;
      allow write: if false;
    }

    // 3. Students Collection (Public read, write restricted to authenticated student owner)
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == studentId;
      allow delete: if false;
    }

    // 4. Submissions Collection (Public read, write restricted to submission owner)
    match /submissions/{submissionId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow delete: if false;
    }
  }
}
